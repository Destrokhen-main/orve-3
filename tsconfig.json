{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "es2020",
    "strict": true,
    "newLine": "LF",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "./node_modules/**/*",
    "**/*.test.ts", 
    "**/*.mock.ts"
  ]
}