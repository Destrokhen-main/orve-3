{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "es2020",
    "strict": true,
    "newLine": "LF",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["jest"],
    "jsx": "react-jsx",
    "jsxImportSource": "orve",
    "paths": {
      "orve": ["./src/index.ts"],
      "orve/jsx-runtime": ["./src/jsx-runtime.ts"],
      "orve/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "experimentalDecorators": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": [
    "./node_modules/**/*",
    "./src/components_old/**/*"
  ]
}
